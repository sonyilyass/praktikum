public class DataArray {
    private Mahasiswa[] mhs;
    private int nElemen;

    public DataArray(int max) {
        mhs = new Mahasiswa[max];
        nElemen = 0;
    }

    public void insert(long nim, String nama) {
        mhs[nElemen] = new Mahasiswa(nim, nama);
        nElemen++;
    }

    public void display() {
        for (int i = 0; i < nElemen; i++) {
            mhs[i].displayMahasiswa();
        }
        System.out.println("");
    }

    // --- SHELL SORT BERDASARKAN NIM ---
    public void shellSortByNim() {
        int in, out;
        Mahasiswa temp;
        int h = 1;

        while (h <= nElemen / 3) {
            h = 3 * h + 1; // Knuth Sequence
        }

        while (h > 0) {
            for (out = h; out < nElemen; out++) {
                temp = mhs[out];
                in = out;
                while (in > h - 1 && mhs[in - h].getNim() >= temp.getNim()) {
                    mhs[in] = mhs[in - h];
                    in -= h;
                }
                mhs[in] = temp;
            }
            h = (h - 1) / 3;
        }
    }

    // --- QUICK SORT BERDASARKAN NAMA ---
    public void quickSortByNama() {
        recQuickSort(0, nElemen - 1);
    }

    private void recQuickSort(int left, int right) {
        if (right - left <= 0) return; // Base case
        
        Mahasiswa pivot = mhs[right];
        int partition = partitionIt(left, right, pivot);
        
        recQuickSort(left, partition - 1);  // Sort kiri
        recQuickSort(partition + 1, right); // Sort kanan
    }

    private int partitionIt(int left, int right, Mahasiswa pivot) {
        int leftPtr = left - 1;
        int rightPtr = right;

        while (true) {
            // Pembandingan String menggunakan compareTo()
            while (mhs[++leftPtr].getNama().compareTo(pivot.getNama()) < 0);
            while (rightPtr > 0 && mhs[--rightPtr].getNama().compareTo(pivot.getNama()) > 0);

            if (leftPtr >= rightPtr) break;
            else swap(leftPtr, rightPtr);
        }
        swap(leftPtr, right);
        return leftPtr;
    }

    private void swap(int dex1, int dex2) {
        Mahasiswa temp = mhs[dex1];
        mhs[dex1] = mhs[dex2];
        mhs[dex2] = temp;
    }
}
